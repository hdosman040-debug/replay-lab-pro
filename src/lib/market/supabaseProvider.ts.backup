import { createClient, type SupabaseClient } from "@supabase/supabase-js";
import type {
  Candle,
  CandleRange,
  DatasetInfo,
  Symbol,
  Timeframe,
} from "./types";
import { TF_SECONDS, floorToTf } from "./types";
import { aggregateCandles } from "./aggregate";

const SUPABASE_URL = import.meta.env.VITE_SUPABASE_URL as string | undefined;
const SUPABASE_ANON_KEY = import.meta.env.VITE_SUPABASE_ANON_KEY as string | undefined;

const BUCKET = "market-data-file";
const ROOT = "US30/M1";

if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
  console.warn(
    "[SupabaseMarketDataProvider] Missing VITE_SUPABASE_URL or VITE_SUPABASE_ANON_KEY",
  );
}

const supabase: SupabaseClient = createClient(
  SUPABASE_URL ?? "",
  SUPABASE_ANON_KEY ?? "",
);

function parseNumber(value: string): number {
  const n = Number(value);
  if (!Number.isFinite(n)) {
    throw new Error(`Invalid numeric value: ${value}`);
  }
  return n;
}

function parseDateTime(value: string): number {
  const normalized = value.trim().replace(/\./g, "-").replace(" ", "T");

  const ms = Date.parse(`${normalized}Z`);

  if (!Number.isFinite(ms)) {
    throw new Error(`Invalid DateTime: ${value}`);
  }

  return Math.floor(ms / 1000);
}

function parseCsv(text: string): Candle[] {
  const lines = text.split(/\r?\n/);
  const candles: Candle[] = [];

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();

    if (!line || i === 0) continue;

    const parts = line.split(/\s+/);

    if (parts.length < 6) continue;

    const [date, time, open, high, low, close, volume] = parts;

    if (!date || !time || !open || !high || !low || !close) {
      continue;
    }

    candles.push({
      time: parseDateTime(`${date} ${time}`),
      open: parseNumber(open),
      high: parseNumber(high),
      low: parseNumber(low),
      close: parseNumber(close),
      volume: volume ? parseNumber(volume) : 0,
    });
  }

  candles.sort((a, b) => a.time - b.time);

  return candles;
}

function monthKey(time: number): { year: number; month: number } {
  const d = new Date(time * 1000);

  return {
    year: d.getUTCFullYear(),
    month: d.getUTCMonth() + 1,
  };
}

function monthPath(year: number, month: number): string {
  return `${ROOT}/${year}/${year}-${String(month).padStart(2, "0")}.csv`;
}

function monthsBetween(from: number, to: number): Array<{ year: number; month: number }> {
  if (to <= from) return [];

  const start = monthKey(from);
  const end = monthKey(to - 1);

  const result: Array<{ year: number; month: number }> = [];

  let year = start.year;
  let month = start.month;

  while (year < end.year || (year === end.year && month <= end.month)) {
    result.push({ year, month });

    month++;

    if (month === 13) {
      month = 1;
      year++;
    }
  }

  return result;
}

async function loadM1Range(from: number, to: number): Promise<Candle[]> {
  if (to <= from) return [];

  const months = monthsBetween(from, to);

  const chunks = await Promise.all(
    months.map(async ({ year, month }) => {
      const path = monthPath(year, month);

      const { data, error } = await supabase.storage
        .from(BUCKET)
        .download(path);

      if (error) {
        throw new Error(`Failed to download ${path}: ${error.message}`);
      }

      const text = await data.text();
      return parseCsv(text);
    }),
  );

  const candles = chunks
    .flat()
    .filter((c) => c.time >= from && c.time < to);

  candles.sort((a, b) => a.time - b.time);

  return candles;
}

class SupabaseMarketDataProviderImpl {
  readonly id = "supabase";

  async getCandles(range: CandleRange): Promise<Candle[]> {
    if (range.symbol !== "US30") {
      throw new Error(`Unsupported symbol: ${range.symbol}`);
    }

    if (range.to <= range.from) {
      return [];
    }

    const m1 = await loadM1Range(range.from, range.to);

    if (range.timeframe === "M1") {
      return m1;
    }

    const aggregated = aggregateCandles(m1, range.timeframe);
    const tfSeconds = TF_SECONDS[range.timeframe];

    return aggregated.filter(
      (c) =>
        c.time >= floorToTf(range.from, range.timeframe) &&
        c.time + tfSeconds <= range.to,
    );
  }

  async getBounds(
    symbol: Symbol,
    timeframe: Timeframe,
  ): Promise<{ earliest: number; latest: number } | null> {
    if (symbol !== "US30") {
      return null;
    }

    const { data, error } = await supabase.storage
      .from(BUCKET)
      .download(monthPath(2016, 10));

    if (error) {
      throw new Error(`Failed to read dataset bounds: ${error.message}`);
    }

    const firstMonth = parseCsv(await data.text());

    if (firstMonth.length === 0) {
      return null;
    }

    const first = firstMonth[0].time;

    const { data: lastData, error: lastError } = await supabase.storage
      .from(BUCKET)
      .download(monthPath(2025, 7));

    if (lastError) {
      throw new Error(`Failed to read dataset bounds: ${lastError.message}`);
    }

    const lastMonth = parseCsv(await lastData.text());

    if (lastMonth.length === 0) {
      return null;
    }

    const lastM1 = lastMonth[lastMonth.length - 1].time;

    if (timeframe === "M1") {
      return {
        earliest: first,
        latest: lastM1,
      };
    }

    const firstBucket = floorToTf(first, timeframe);
    const lastBucket = floorToTf(lastM1, timeframe);

    return {
      earliest: firstBucket,
      latest: lastBucket,
    };
  }

  async listDatasets(): Promise<DatasetInfo[]> {
    const bounds = await this.getBounds("US30", "M1");

    if (!bounds) {
      return [];
    }

    return [
      {
        symbol: "US30",
        timeframe: "M1",
        status: "ready",
        candleCount: 2_880_287,
        earliest: bounds.earliest,
        latest: bounds.latest,
        source: "Supabase Storage: market-data-file",
      },
    ];
  }
}

export const supabaseMarketDataProvider =
  new SupabaseMarketDataProviderImpl();
