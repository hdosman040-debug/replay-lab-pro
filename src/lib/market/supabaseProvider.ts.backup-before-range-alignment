import { createClient, type SupabaseClient } from "@supabase/supabase-js";
import type {
  Candle,
  CandleRange,
  DatasetInfo,
  Symbol,
  Timeframe,
} from "./types";
import { TF_SECONDS, floorToTf } from "./types";
import { aggregateCandles } from "./aggregate";

const SUPABASE_URL = import.meta.env.VITE_SUPABASE_URL as string | undefined;
const SUPABASE_ANON_KEY = import.meta.env.VITE_SUPABASE_ANON_KEY as string | undefined;

const BUCKET = "market-data-file";
const ROOT = "US30/M1";

/**
 * Maximum number of monthly M1 files kept in memory.
 *
 * The replay engine can jump backward/forward, so a small LRU cache prevents
 * repeated Storage downloads without allowing the browser to accumulate the
 * entire historical dataset in RAM.
 */
const MAX_MONTH_CACHE = 4;

if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
  console.warn(
    "[SupabaseMarketDataProvider] Missing VITE_SUPABASE_URL or VITE_SUPABASE_ANON_KEY",
  );
}

const supabase: SupabaseClient = createClient(
  SUPABASE_URL ?? "",
  SUPABASE_ANON_KEY ?? "",
);

function parseNumber(value: string): number {
  const n = Number(value);

  if (!Number.isFinite(n)) {
    throw new Error(`Invalid numeric value: ${value}`);
  }

  return n;
}

function parseDateTime(value: string): number {
  const normalized = value.trim().replace(/\./g, "-").replace(" ", "T");
  const ms = Date.parse(`${normalized}Z`);

  if (!Number.isFinite(ms)) {
    throw new Error(`Invalid DateTime: ${value}`);
  }

  return Math.floor(ms / 1000);
}

function parseCsv(text: string): Candle[] {
  const lines = text.split(/\r?\n/);
  const candles: Candle[] = [];

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();

    if (!line || i === 0) continue;

    const parts = line.split(",").map((part) => part.trim());

    if (parts.length < 5) continue;

    const [dateTime, open, high, low, close, volume] = parts;

    if (!dateTime || !open || !high || !low || !close) {
      continue;
    }

    candles.push({
      time: parseDateTime(dateTime),
      open: parseNumber(open),
      high: parseNumber(high),
      low: parseNumber(low),
      close: parseNumber(close),
      volume: volume ? parseNumber(volume) : 0,
    });
  }

  candles.sort((a, b) => a.time - b.time);

  return candles;
}

function monthKey(time: number): { year: number; month: number } {
  const d = new Date(time * 1000);

  return {
    year: d.getUTCFullYear(),
    month: d.getUTCMonth() + 1,
  };
}

function monthPath(year: number, month: number): string {
  return `${ROOT}/${year}/${year}-${String(month).padStart(2, "0")}.csv`;
}

function monthsBetween(
  from: number,
  to: number,
): Array<{ year: number; month: number }> {
  if (to <= from) return [];

  const start = monthKey(from);
  const end = monthKey(to - 1);

  const result: Array<{ year: number; month: number }> = [];

  let year = start.year;
  let month = start.month;

  while (year < end.year || (year === end.year && month <= end.month)) {
    result.push({ year, month });

    month++;

    if (month === 13) {
      month = 1;
      year++;
    }
  }

  return result;
}

type MonthCacheEntry = {
  key: string;
  candles: Candle[];
};

/**
 * Small in-memory LRU cache.
 *
 * Map insertion order represents recency:
 * oldest = first key
 * newest = last key
 */
const monthCache = new Map<string, MonthCacheEntry>();

type AvailableMonth = {
  year: number;
  month: number;
};

let availableMonthsCache: AvailableMonth[] | null = null;
let availableMonthsPromise: Promise<AvailableMonth[]> | null = null;

async function listAvailableMonths(): Promise<AvailableMonth[]> {
  if (availableMonthsCache) {
    return availableMonthsCache;
  }

  if (availableMonthsPromise) {
    return availableMonthsPromise;
  }

  availableMonthsPromise = (async () => {
    const { data: yearEntries, error: yearError } = await supabase.storage
      .from(BUCKET)
      .list(ROOT, {
        limit: 1000,
        sortBy: { column: "name", order: "asc" },
      });

    if (yearError) {
      throw new Error(
        `Failed to list ${ROOT}: ${yearError.message}`,
      );
    }

    const years = (yearEntries ?? [])
      .filter((entry) => /^\d{4}$/.test(entry.name))
      .map((entry) => Number(entry.name));

    const results = await Promise.all(
      years.map(async (year) => {
        const { data, error } = await supabase.storage
          .from(BUCKET)
          .list(`${ROOT}/${year}`, {
            limit: 1000,
            sortBy: { column: "name", order: "asc" },
          });

        if (error) {
          throw new Error(
            `Failed to list ${ROOT}/${year}: ${error.message}`,
          );
        }

        return (data ?? [])
          .map((entry) => entry.name.match(/^(\d{4})-(\d{2})\.csv$/))
          .filter(
            (
              match,
            ): match is RegExpMatchArray => match !== null,
          )
          .map((match) => ({
            year: Number(match[1]),
            month: Number(match[2]),
          }));
      }),
    );

    const months = results
      .flat()
      .sort(
        (a, b) =>
          a.year - b.year ||
          a.month - b.month,
      );

    availableMonthsCache = months;
    return months;
  })();

  try {
    return await availableMonthsPromise;
  } finally {
    availableMonthsPromise = null;
  }
}

function cacheKey(year: number, month: number): string {
  return `${year}-${String(month).padStart(2, "0")}`;
}

function getCachedMonth(key: string): Candle[] | null {
  const entry = monthCache.get(key);

  if (!entry) {
    return null;
  }

  // Refresh LRU position.
  monthCache.delete(key);
  monthCache.set(key, entry);

  return entry.candles;
}

function setCachedMonth(key: string, candles: Candle[]): void {
  monthCache.delete(key);
  monthCache.set(key, { key, candles });

  while (monthCache.size > MAX_MONTH_CACHE) {
    const oldestKey = monthCache.keys().next().value;

    if (!oldestKey) break;

    monthCache.delete(oldestKey);
  }
}

async function loadMonth(year: number, month: number): Promise<Candle[]> {
  const key = cacheKey(year, month);

  const cached = getCachedMonth(key);

  if (cached) {
    return cached;
  }

  const path = monthPath(year, month);

  const { data, error } = await supabase.storage
    .from(BUCKET)
    .download(path);

  if (error) {
    // A month that has not been uploaded is an empty month, not a
    // fatal replay error. Other Storage errors must still surface.
    const statusCode = (error as { statusCode?: number | string }).statusCode;
    const message = String(error.message ?? "").toLowerCase();
    const isMissingObject =
      statusCode === 404 ||
      statusCode === "404" ||
      message.includes("not found") ||
      message.includes("object not found");

    if (isMissingObject) {
      const candles: Candle[] = [];
      setCachedMonth(key, candles);
      return candles;
    }

    throw new Error(`Failed to download ${path}: ${error.message}`);
  }

  const candles = parseCsv(await data.text());

  setCachedMonth(key, candles);

  return candles;
}

async function loadM1Range(from: number, to: number): Promise<Candle[]> {
  if (to <= from) return [];

  const months = monthsBetween(from, to);

  const chunks = await Promise.all(
    months.map(({ year, month }) => loadMonth(year, month)),
  );

  const candles = chunks
    .flat()
    .filter((c) => c.time >= from && c.time < to);

  candles.sort((a, b) => a.time - b.time);

  return candles;
}

class SupabaseMarketDataProviderImpl {
  readonly id = "supabase";

  async getCandles(range: CandleRange): Promise<Candle[]> {
    if (range.symbol !== "US30") {
      throw new Error(`Unsupported symbol: ${range.symbol}`);
    }

    if (range.to <= range.from) {
      return [];
    }

    const m1 = await loadM1Range(range.from, range.to);

    if (range.timeframe === "M1") {
      return m1;
    }

    const aggregated = aggregateCandles(m1, range.timeframe);
    const tfSeconds = TF_SECONDS[range.timeframe];

    return aggregated.filter(
      (c) =>
        c.time >= floorToTf(range.from, range.timeframe) &&
        c.time + tfSeconds <= range.to,
    );
  }

  async getBounds(
    symbol: Symbol,
    timeframe: Timeframe,
  ): Promise<{ earliest: number; latest: number } | null> {
    if (symbol !== "US30") {
      return null;
    }

    const availableMonths = await listAvailableMonths();

    if (availableMonths.length === 0) {
      return null;
    }

    const firstMonth = availableMonths[0];
    const lastMonth = availableMonths[availableMonths.length - 1];

    const firstCandles = await loadMonth(
      firstMonth.year,
      firstMonth.month,
    );

    if (firstCandles.length === 0) {
      return null;
    }

    const lastCandles = await loadMonth(
      lastMonth.year,
      lastMonth.month,
    );

    if (lastCandles.length === 0) {
      return null;
    }

    const first = firstCandles[0].time;
    const lastM1 = lastCandles[lastCandles.length - 1].time;

    if (timeframe === "M1") {
      return {
        earliest: first,
        latest: lastM1,
      };
    }

    const firstBucket = floorToTf(first, timeframe);
    const lastBucket = floorToTf(lastM1, timeframe);

    return {
      earliest: firstBucket,
      latest: lastBucket,
    };
  }

  async listDatasets(): Promise<DatasetInfo[]> {
    const bounds = await this.getBounds("US30", "M1");

    if (!bounds) {
      return [];
    }

    return [
      {
        symbol: "US30",
        timeframe: "M1",
        status: "ready",
        candleCount: 2_880_287,
        earliest: bounds.earliest,
        latest: bounds.latest,
        source: "Supabase Storage: market-data-file",
      },
    ];
  }
}

export const supabaseMarketDataProvider =
  new SupabaseMarketDataProviderImpl();
