@import "tailwindcss" source(none);
@source "../src";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

/*
 * ICT Trade Terminal design system.
 * Dark trading-workspace: near-black graphite surfaces, cool grey text,
 * amber accent for the replay clock / actions, teal for bullish, rose for bearish.
 */

@theme inline {
  --font-sans: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);

  --color-surface: var(--surface);
  --color-surface-2: var(--surface-2);
  --color-surface-3: var(--surface-3);
  --color-bull: var(--bull);
  --color-bear: var(--bear);
  --color-warn: var(--warn);
  --color-info: var(--info);
  --color-liquidity: var(--liquidity);
  --color-structure: var(--structure);
  --color-poi: var(--poi);
  --color-pa: var(--pa);
  --color-chart-grid: var(--chart-grid);
}

:root {
  --radius: 0.5rem;

  --background: oklch(0.155 0.008 250);
  --foreground: oklch(0.9 0.01 250);
  --card: oklch(0.19 0.009 250);
  --card-foreground: oklch(0.9 0.01 250);
  --popover: oklch(0.21 0.01 250);
  --popover-foreground: oklch(0.9 0.01 250);

  --primary: oklch(0.8 0.15 75);
  --primary-foreground: oklch(0.17 0.02 75);
  --secondary: oklch(0.25 0.01 250);
  --secondary-foreground: oklch(0.9 0.01 250);
  --muted: oklch(0.23 0.008 250);
  --muted-foreground: oklch(0.62 0.015 250);
  --accent: oklch(0.28 0.012 250);
  --accent-foreground: oklch(0.95 0.01 250);
  --destructive: oklch(0.62 0.2 20);
  --destructive-foreground: oklch(0.98 0 0);
  --border: oklch(0.28 0.01 250);
  --input: oklch(0.3 0.01 250);
  --ring: oklch(0.8 0.15 75);

  --surface: oklch(0.13 0.007 250);
  --surface-2: oklch(0.175 0.008 250);
  --surface-3: oklch(0.22 0.01 250);

  --bull: oklch(0.75 0.14 170);
  --bear: oklch(0.66 0.2 15);
  --warn: oklch(0.8 0.15 75);
  --info: oklch(0.72 0.12 230);

  --liquidity: oklch(0.78 0.13 230);
  --structure: oklch(0.85 0.05 250);
  --poi: oklch(0.75 0.13 300);
  --pa: oklch(0.8 0.15 75);
  --chart-grid: oklch(0.21 0.008 250);
}

@layer base {
  * {
    border-color: var(--color-border);
  }
  html {
    color-scheme: dark;
    -webkit-tap-highlight-color: transparent;
  }
  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    font-size: 14px;
    overscroll-behavior: none;
    -webkit-font-smoothing: antialiased;
  }
  input,
  select,
  textarea {
    font: inherit;
  }
  ::-webkit-scrollbar {
    width: 0;
    height: 0;
  }
}

@utility num {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

@utility touch-btn {
  min-height: 44px;
  min-width: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  color: var(--color-foreground);
  transition:
    background-color 120ms,
    color 120ms;
  &:active {
    background-color: var(--color-accent);
  }
}

@utility panel-input {
  width: 100%;
  min-height: 40px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background-color: var(--color-surface);
  padding: 0.4rem 0.6rem;
  font-size: 0.875rem;
  color: var(--color-foreground);
  outline: none;
  &:focus {
    border-color: var(--color-ring);
  }
}

@utility chip {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  min-height: 32px;
  padding: 0 0.7rem;
  border-radius: 999px;
  border: 1px solid var(--color-border);
  background-color: var(--color-surface-2);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--color-muted-foreground);
  white-space: nowrap;
  transition:
    background-color 120ms,
    color 120ms,
    border-color 120ms;
  &[data-active="true"] {
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
    border-color: var(--color-primary);
  }
}

@utility eyebrow {
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--color-muted-foreground);
}

@utility no-scrollbar {
  scrollbar-width: none;
  &::-webkit-scrollbar {
    display: none;
  }
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
